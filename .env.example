# ============================================================
#  PetaniMaju — konfigurasi aplikasi (Flutter)
# ============================================================
# 1. Salin file ini menjadi ".env" (sejajar pubspec.yaml).
# 2. Isi nilainya (tanpa tanda kutip).
# 3. Jalankan:
#      flutter run --dart-define-from-file=.env
#      flutter build apk --dart-define-from-file=.env
#
# File .env sudah masuk .gitignore — JANGAN di-commit.
# Semua nilai di bawah ikut ter-bundle di APK, jadi hanya isi
# kunci yang memang aman untuk client (publishable/anon).
# Server key Midtrans TIDAK ditaruh di sini — lihat
# supabase/functions/.env.example.

# ---------- Supabase (wajib) --------------------------------
# Dashboard > Project Settings > API (project: Tumbuhin.id)
# SUPABASE_URL      : Project URL
# SUPABASE_ANON_KEY : anon / publishable key (BUKAN service_role)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- OpenWeatherMap (wajib) --------------------------
# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# ---------- Google Gemini (wajib untuk Scan & Asisten Tani) --
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------- Opsional ----------------------------------------
# Email tujuan tombol "Hubungi Kami" di layar Bantuan.
SUPPORT_EMAIL=
