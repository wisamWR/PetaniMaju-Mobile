# ============================================================
#  Secrets untuk Supabase Edge Functions (server side)
# ============================================================
# Salin menjadi supabase/functions/.env, isi, lalu upload:
#   supabase secrets set --env-file supabase/functions/.env --project-ref lmbsryezpadlsbxznezl
#
# JANGAN taruh nilai ini di .env aplikasi Flutter — server key
# Midtrans bisa dipakai untuk menarik/menagih uang atas nama akun Anda.
#
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# sudah otomatis tersedia di Edge Function, tidak perlu diisi.

# ---------- Midtrans --------------------------------------
# Sandbox: https://dashboard.sandbox.midtrans.com > Settings > Access Keys
# Server key sandbox diawali "SB-Mid-server-".
MIDTRANS_SERVER_KEY=

# "false" = sandbox (uji coba), "true" = production (uang sungguhan)
MIDTRANS_IS_PRODUCTION=false
